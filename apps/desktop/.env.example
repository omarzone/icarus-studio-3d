# Community connection a release is built with. Copy to .env.production before building a release.
# Only the public anon key belongs here: the service role key and the database address stay on the server.
MAIN_VITE_COMMUNITY_URL=https://community.example.org
MAIN_VITE_SUPABASE_URL=https://your-project.supabase.co
MAIN_VITE_SUPABASE_ANON_KEY=
