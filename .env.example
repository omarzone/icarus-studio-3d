# Model connection for the copilot during development. The settings screen (Settings › AI models) stores its own
# values outside the repo and they take precedence. One OpenAI-compatible endpoint and key, one model per capability.
ICARUS_MODEL_ENDPOINT=
ICARUS_MODEL_API_KEY=
ICARUS_MODEL_REASONING=
ICARUS_MODEL_VISION=
# "fake" answers from the recorded fixtures in services/engine/tests/copilot/fixtures, offline.
ICARUS_COPILOT_PROVIDER=

# Community: the app finds the community service through one setting, community_url in community.json in the settings
# folder (Settings › Profile › Community server), default http://127.0.0.1:8790. Empty Supabase URL and anon key there
# mean the server's development sign-in. The service's own settings are in services/community/.env.example.
