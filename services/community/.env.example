# Community service settings. Copy to `.env` in this folder (never commit `.env`) or set them in the environment.

# development · test · production. Production refuses DEV_AUTH and requires SUPABASE_URL or SUPABASE_JWT_SECRET.
ENV=development

# SQLite file locally; a Postgres URL on a server, for example
# postgresql+psycopg://icarus:secret@db:5432/icarus (install with `uv sync --extra postgres`).
DATABASE_URL=sqlite:///./data/community.db
# Where bundles, thumbnails and photos are kept.
FILES_DIR=./data/files
# The address people reach this service at; used in share links.
PUBLIC_URL=http://127.0.0.1:8790
# Browser origins allowed to call the API, as a JSON list. The desktop app does not need any.
CORS_ORIGINS=[]

# Sign-in. Empty SUPABASE_URL plus DEV_AUTH=true is the local development mode: the service signs its own
# short-lived tokens at POST /v1/dev/token for any email. Never turn DEV_AUTH on for a server people use.
DEV_AUTH=true
SUPABASE_URL=
# Only for Supabase projects still on the legacy shared JWT secret; leave empty to verify with the project's JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_AUDIENCE=authenticated
# Optional: lets "Delete account" also delete the Supabase user. Server-side only; never give it to the app.
SUPABASE_SERVICE_ROLE_KEY=

# Emails that get the moderator role when they sign in, as a JSON list.
MODERATOR_EMAILS=["dev@icarus.localhost"]
# true holds new creations for a moderator before they are listed.
MODERATION_REQUIRED=false

WRITES_PER_MINUTE=60
MAX_BUNDLE_BYTES=8388608
MAX_IMAGE_BYTES=2097152
