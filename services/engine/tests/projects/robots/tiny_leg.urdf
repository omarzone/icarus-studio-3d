<?xml version="1.0"?>
<robot name="tiny_leg">
  <link name="base_link">
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
    </collision>
  </link>
  <link name="thigh">
    <inertial>
      <origin xyz="0 0 -0.15"/>
      <mass value="0.4"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0002"/>
    </inertial>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.3"/></geometry>
    </collision>
  </link>
  <link name="shin">
    <inertial>
      <origin xyz="0 0 -0.15"/>
      <mass value="0.3"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0001"/>
    </inertial>
    <collision>
      <origin xyz="0 0 -0.15"/>
      <geometry><mesh filename="package://tiny_leg/meshes/shin.stl"/></geometry>
    </collision>
  </link>
  <joint name="hip" type="revolute">
    <parent link="base_link"/>
    <child link="thigh"/>
    <origin xyz="0.1 0 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="12" velocity="5"/>
  </joint>
  <joint name="knee" type="revolute">
    <parent link="thigh"/>
    <child link="shin"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="0" effort="8" velocity="5"/>
  </joint>
</robot>
